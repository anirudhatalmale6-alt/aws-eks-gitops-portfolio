# Rename this to backend.tf AFTER the bucket exists, then run
#
#   terraform init -migrate-state
#
# and answer yes. That copies the local terraform.tfstate into the bucket. Delete
# terraform.tfstate and terraform.tfstate.backup afterwards so there is no second
# copy to drift.
#
# Fill in the bucket name from `terraform output state_bucket_name`.

terraform {
  backend "s3" {
    bucket = "REPLACE-ME-eks-gitops-portfolio-tfstate-000000000000"
    key    = "bootstrap/terraform.tfstate"
    region = "us-east-1"

    encrypt = true

    # Native S3 state locking, Terraform 1.10 and later. No DynamoDB table.
    use_lockfile = true
  }
}
